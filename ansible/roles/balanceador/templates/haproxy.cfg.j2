# Fichero generado por Ansible (rol balanceador): no lo edites a mano
global
    log /dev/log local0
    maxconn 2048
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5s
    timeout client  30s
    timeout server  30s

# Punto de entrada: recibe las peticiones del anfitrión
frontend http_in
    bind *:{{ haproxy_frontend_port }}
    default_backend webservers

# Reparte en round-robin entre los servidores web por la red de datos.
# Sesiones persistentes (sticky): HAProxy inserta una cookie SERVERID para que
# cada cliente se quede en el mismo backend y no se pierda la sesión PHP (el
# token CSRF del guestbook vive en $_SESSION). El reparto sigue siendo
# round-robin para cada cliente nuevo.
backend webservers
    balance roundrobin
    cookie SERVERID insert indirect nocache
{% for b in web_backends %}
    server {{ b.nombre }} {{ b.ip }}:80 check cookie {{ b.nombre }}
{% endfor %}

# Página de estadísticas (para ver el reparto y el estado de los backends)
listen stats
    bind *:8404
    stats enable
    stats uri /
    stats refresh 5s
