# Fichero generado por OpenTofu (inventario.tf): no lo edites a mano
all:
  children:
    servidores_balanceador:
      hosts:
        balanceador:
          ansible_host: ${ip_balanceador}
          ansible_user: debian
          ansible_ssh_private_key_file: ~/.ssh/id_rsa

    servidores_web:
      hosts:
%{ for nombre, ip in webs ~}
        ${nombre}:
          ansible_host: ${ip}
          ansible_user: debian
          ansible_ssh_private_key_file: ~/.ssh/id_rsa
          # Sin interfaz NAT: se entra por la red de datos saltando por el balanceador
          ansible_ssh_common_args: '-o ProxyJump=debian@${ip_balanceador} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
%{ endfor ~}

    servidores_almacen:
      hosts:
        almacen:
          ansible_host: ${ip_almacen}
          ansible_user: debian
          ansible_ssh_private_key_file: ~/.ssh/id_rsa
          # Sin interfaz NAT: se entra por la red de datos saltando por el balanceador
          ansible_ssh_common_args: '-o ProxyJump=debian@${ip_balanceador} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

    servidores_bd:
      hosts:
        bd:
          ansible_host: ${ip_bd}
          ansible_user: ubuntu
          ansible_ssh_private_key_file: ~/.ssh/id_rsa
